{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lorawan-schema.org/payload-schema/v1",
  "title": "LoRaWAN Payload Schema",
  "description": "Schema for defining LoRaWAN device payload codec descriptions",
  "type": "object",
  "definitions": {
    "field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Field name in decoded output. Prefix with _ for internal/hidden fields."
        },
        "type": {
          "type": "string",
          "description": "Data type. Standard types or the bitfield range uN[start:end], e.g. u8[3:4]"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "description": "Byte length for bytes/string/hex/base64/bitfield_string/version_string types"
        },
        "consume": {
          "type": "integer",
          "minimum": 0,
          "description": "Bytes to advance after reading. 0 = don't advance (shared byte)."
        },
        "bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7,
          "description": "Bit position for bool type"
        },
        "mult": {
          "type": "number",
          "description": "Multiply raw value by this factor"
        },
        "div": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Divide raw value by this factor"
        },
        "add": {
          "type": "number",
          "description": "Add this offset to raw value"
        },
        "formula": {
          "type": "string",
          "description": "Custom formula using 'x' for raw value and $field for cross-references"
        },
        "encode_formula": {
          "type": "string",
          "description": "Custom inverse formula for encoding (Phase 3)"
        },
        "unit": {
          "type": "string",
          "description": "Engineering unit (e.g., degC, %RH, mV)"
        },
        "valid_range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Expected value bounds [min, max]. Out-of-range values produce quality warnings."
        },
        "resolution": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Minimum detectable change (e.g., 0.01 for 0.01\u00b0C steps)"
        },
        "unece": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,3}$",
          "description": "UNECE Recommendation 20 unit code (e.g., CEL for Celsius, FAH for Fahrenheit)"
        },
        "var": {
          "type": "string",
          "description": "Store decoded value as variable for later match/formula references"
        },
        "lookup": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lookup table: index -> string value"
        },
        "values": {
          "description": "Enum values: dict {int: string} or list [string]"
        },
        "base": {
          "type": "string",
          "description": "Base integer type for enum (default: u8)"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          },
          "description": "Nested fields for object type"
        },
        "on": {
          "type": "string",
          "description": "Match discriminator field name (legacy syntax)"
        },
        "cases": {
          "description": "Match cases: legacy [{case:, fields:}] or Option B {value: [fields]}"
        },
        "default": {
          "description": "Default case behavior: 'error', 'skip', or {fields: [...]}"
        },
        "semantic": {
          "type": "object",
          "properties": {
            "ipso": {
              "type": "integer",
              "description": "IPSO Smart Object ID"
            },
            "senml": {
              "type": "string",
              "description": "SenML name"
            }
          },
          "description": "Semantic mapping for output formats"
        },
        "description": {
          "type": "string",
          "description": "Human-readable field description"
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "integer",
                "description": "Bit offset"
              },
              {
                "type": "integer",
                "description": "Bit length"
              }
            ]
          },
          "description": "Bitfield string parts: [[bitOffset, bitLength, format?], ...]"
        },
        "delimiter": {
          "type": "string",
          "description": "Delimiter for bitfield_string/version_string assembly"
        },
        "prefix": {
          "type": "string",
          "description": "Prefix for bitfield_string/version_string output"
        },
        "tlv": {
          "$ref": "#/definitions/tlv"
        },
        "flagged": {
          "$ref": "#/definitions/flagged"
        }
      },
      "additionalProperties": true
    },
    "tlv": {
      "type": "object",
      "description": "TLV loop: read a tag, select the case describing it, decode that case's fields, repeat to the end of the payload (PS-153, PS-154).",
      "properties": {
        "tag_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "Width in bytes of a tag read as one integer. Mutually exclusive with tag_fields."
        },
        "tag_fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          },
          "minItems": 1,
          "description": "A composite tag, read as named fields; the tag is their values in this order. Mutually exclusive with tag_size."
        },
        "tag_key": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Names of the tag_fields that form the key, in order. Read on encode to write each component back through its own tag_fields entry. Not read by the TS013 generator, which derives the key from tag_fields directly."
        },
        "length_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Width in bytes of a length field following the tag. 0 or absent means the entry is undelimited, so an unrecognised tag cannot be stepped over (PS-302)."
        },
        "merge": {
          "type": "boolean",
          "default": true,
          "description": "Whether a case's fields go into the parent object (PS-156). False collects each entry into a channel list instead."
        },
        "unknown": {
          "enum": [
            "skip",
            "raw",
            "error"
          ],
          "default": "skip",
          "description": "What to do with a tag no case describes (PS-155, PS-301 to PS-304). `skip` steps over it where a length says how long it is and otherwise abandons the rest of the payload; `raw` captures its bytes under `unknown_tags` (PS-303); `error` fails the decode. Every mode but `error` reports what it did. Implementations fall back to `skip` on an unrecognised value, so a misspelling silently discards data - tools/validate_schema.py refuses one."
        },
        "cases": {
          "type": "object",
          "description": "Tag to the fields it introduces. A key is an integer (`1`, or `0x20` which YAML reads as 32); a range `\"2..5\"` or a list `[1, 2, 3]` for a single tag; a composite `\"[1, 117]\"` for a tag read through tag_fields, where a part may be `*` for any value or `!0` for any value but that one (PS-270); or `default`.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/field"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "flagged": {
      "type": "object",
      "description": "Bitmask-driven presence: a previously decoded field is read as a mask, and each group whose bit is set contributes its fields (PS-158). Groups are evaluated in the order written, which is the order their bytes appear (PS-160).",
      "properties": {
        "field": {
          "type": "string",
          "description": "Name of the field holding the mask, which must already have been decoded (PS-159). A bare name - `flags`, not `$flags` - unlike the $-prefixed references used by `ref` and `compute`."
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/flagged_group"
          },
          "minItems": 1,
          "description": "The bits and what each introduces."
        }
      },
      "required": [
        "field",
        "groups"
      ],
      "additionalProperties": false
    },
    "flagged_group": {
      "type": "object",
      "description": "One bit of the mask and the fields its being set introduces.",
      "properties": {
        "bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63,
          "description": "Bit position, 0 being the least significant (PS-161, PS-162). Set means this group's fields are read from the payload; clear means the group is skipped and consumes nothing. The ceiling is 63 because u64 is a flags type; the useful ceiling is the width of the referenced field. tools/validate_schema.py also refuses two groups claiming the same bit, which JSON Schema cannot express."
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          },
          "minItems": 1,
          "description": "Read in order where the bit is set, and merged into the parent object (PS-163). A name beginning with _ is internal: it becomes a variable later fields can reference and is not reported."
        }
      },
      "required": [
        "bit",
        "fields"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "description": "Schema name (typically device model)"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version"
    },
    "endian": {
      "type": "string",
      "enum": [
        "big",
        "little"
      ],
      "default": "big",
      "description": "Default byte order"
    },
    "description": {
      "type": "string",
      "description": "Human-readable schema description"
    },
    "manufacturer": {
      "type": "string",
      "description": "Device manufacturer name"
    },
    "device": {
      "type": "string",
      "description": "Device model name"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "description": "Field definitions (for single-port schemas)"
    },
    "ports": {
      "type": "object",
      "description": "Port-based field definitions: {port_number: {fields: [...]}}"
    },
    "definitions": {
      "type": "object",
      "description": "Reusable field group definitions for $ref"
    },
    "test_vectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "payload": {
            "description": "Hex string, byte array, or 0x-prefixed string"
          },
          "fport": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255,
            "description": "Deprecated spelling of fPort; accepted, not emitted (PS-300)"
          },
          "fPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "expected": {
            "type": "object",
            "description": "Expected decoded field values"
          },
          "input_metadata": {
            "type": "object",
            "description": "TS013 input metadata for testing"
          },
          "source": {
            "type": "string",
            "enum": [
              "vendor-doc",
              "vendor-codec",
              "field-capture",
              "spec-example",
              "generated"
            ],
            "description": "Provenance of the expected values (PS-263). Absent means unknown, which certification treats as 'generated'."
          },
          "input": {
            "type": "object",
            "description": "Values to encode, for an encode vector (PS-047)"
          },
          "expected_payload": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              }
            ],
            "description": "Expected encoded bytes, hex string or byte array (PS-047, PS-299)"
          },
          "direction": {
            "type": "string",
            "enum": [
              "uplink",
              "downlink"
            ],
            "description": "Direction the vector exercises; inferred from the keys when absent"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255,
            "description": "Deprecated spelling of fPort; accepted, not emitted (PS-300)"
          },
          "expected_warnings": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              ]
            },
            "description": "Warnings the execution must report, complete and in order (PS-305). An entry is a substring of the warning at that position, or an array of substrings all of which must appear in it (PS-306). An empty array asserts that none were reported; absent asserts nothing (PS-308)."
          }
        },
        "oneOf": [
          {
            "title": "decode vector",
            "required": [
              "name",
              "payload",
              "expected"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "input"
                  ]
                },
                {
                  "required": [
                    "expected_payload"
                  ]
                }
              ]
            }
          },
          {
            "title": "encode vector",
            "required": [
              "name",
              "input",
              "expected_payload"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "payload"
                  ]
                },
                {
                  "required": [
                    "expected"
                  ]
                }
              ]
            }
          }
        ]
      },
      "description": "Test cases for validation"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "description": "$ reference to TS013 input"
              }
            },
            "required": [
              "name",
              "source"
            ]
          }
        },
        "timestamps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "rx_time",
                  "subtract",
                  "unix_epoch",
                  "iso8601",
                  "elapsed_to_absolute"
                ]
              },
              "field": {
                "type": "string"
              },
              "offset_field": {
                "type": "string"
              },
              "elapsed_field": {
                "type": "string"
              },
              "time_base": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "description": "strftime format for iso8601 mode"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "anyOf": [
    {
      "required": [
        "fields"
      ]
    },
    {
      "required": [
        "ports"
      ]
    }
  ]
}
